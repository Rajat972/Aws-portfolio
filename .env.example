# Environment Configuration for Portfolio Web App & Email Notifications

# SMTP Server Host (For Gmail use smtp.gmail.com, Outlook use smtp.office365.com)
SMTP_SERVER=smtp.gmail.com

# SMTP Server Port (Typically 587 for TLS, 465 for SSL)
SMTP_PORT=587

# The email address used to send the notification
SENDER_EMAIL=rajatrajput076@gmail.com

# Password or App Password for SENDER_EMAIL
# For Gmail, generate an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SENDER_PASSWORD=your_app_password_here

# The email address that receives visitor contact notifications
RECEIVER_EMAIL=rajatrajput076@gmail.com
